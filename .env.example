# Copy to .env and fill in. Everything here has a working default except the
# two connection strings, so the API runs before you have signed up for
# anything -- see README.md.
#
#   cp .env.example .env

# ---------------------------------------------------------------- server

ADDR=:8080

# Where the React app is served. Invite links are built from this, so it has to
# match the origin guests actually open. For testing on a phone on the same
# wifi, use your machine's LAN address, not localhost:
#   APP_BASE_URL=http://192.168.18.31:5173
APP_BASE_URL=http://localhost:5173

# Browser origins allowed to call this API. Comma separated.
# 5173 is `npm run dev`, 4173 is `npm run preview`.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# Signs admin and MC/speaker sessions. Generate one:
#   openssl rand -base64 32
# Leave it empty and the server makes a temporary one at boot, which signs
# everyone out on every restart.
SESSION_SECRET=

# ---------------------------------------------------------------- database

# Supabase Postgres. Empty = in-memory mode: the API serves the same sample
# data the frontend ships with and forgets everything on restart.
#
# Supabase dashboard -> Connect -> ORMs/Postgres. Use the *pooled* string
# (port 6543) and add sslmode=require:
#
#   postgresql://postgres.abcdefgh:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require
#
# Run migrations/001_init.sql once in the SQL Editor first.
DATABASE_URL=

# Fills an empty database with 32 sample guests and a rundown. Set to false
# for the real event: the committee enters its own list and every number on
# the dashboard is real from the first one.
SEED=true

# ---------------------------------------------------------------- redis

# Upstash Redis, or a local one from docker-compose.yml. Empty = an in-process
# stand-in that works fine for a single API instance.
#
# Upstash console -> your database -> Connect -> redis-cli / TCP. Note it is
# rediss:// with two s, for TLS:
#
#   rediss://default:PASSWORD@apn1-xxxx.upstash.io:6379
#
# Local via docker compose up -d:
#   redis://localhost:6379
REDIS_URL=

# ---------------------------------------------------------------- prototype codes

# Kept identical to the frontend (src/config.ts, src/admin/data.ts,
# src/stage/StageLogin.tsx) so the existing login screens work unchanged.
# Change all of these before anything real.

ADMIN_EMAIL=admin@potara.id
ADMIN_PIN=123456

# Door check-in code, and the committee's manual check-in PIN.
# Initial values only. Once the committee saves the Pengaturan page, the
# settings row in the database owns these and changing them here does nothing.
DOOR_CODE=1108
PANITIA_PIN=2026
